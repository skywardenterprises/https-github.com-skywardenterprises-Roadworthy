    "Save or discard your changes before marking this done." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda o descarta tus cambios antes de marcar esto como hecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez ou annulez vos modifications avant de marquer ceci comme fait."
          }
        }
      }
    },
    "Save part numbers and torque specs here so you're never digging through old receipts again." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda aquí números de pieza y especificaciones de torque para no volver a buscar entre recibos viejos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez ici les numéros de pièces et les couples de serrage pour ne plus fouiller dans vos vieux reçus."
          }
        }
      }
    },
    "Saved on this device only since %@. Code %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado solo en este dispositivo desde el %@. Código %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré uniquement sur cet appareil depuis le %@. Code %@."
          }
        }
      }
    },
    "Scan or enter the 17-character VIN and Roadworthy will fill in the year, make, model, engine and other details. You can also skip this and enter everything yourself." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanee o introduzca el VIN de 17 caracteres y Roadworthy completará el año, la marca, el modelo, el motor y otros datos. También puede omitir este paso e ingresar todo usted mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez ou saisissez le VIN à 17 caractères et Roadworthy renseignera l'année, la marque, le modèle, le moteur et d'autres détails. Vous pouvez aussi passer cette étape et tout saisir vous-même."
          }
        }
      }
    },
    "Scan VIN" : {
