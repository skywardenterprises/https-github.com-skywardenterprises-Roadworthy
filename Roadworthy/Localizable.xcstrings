    "This notification date has already passed, so no notification will be scheduled. Mark the reminder as done to start the next interval." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta fecha de notificación ya pasó, por lo que no se programará ninguna notificación. Marca el recordatorio como hecho para iniciar el siguiente intervalo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette date de notification est déjà passée ; aucune notification ne sera programmée. Marquez le rappel comme terminé pour démarrer l'intervalle suivant."
          }
        }
      }
    },
    "This permanently deletes %@ and all %lld of its logs, photos, and documents from all your devices. Marking it inactive keeps everything and moves it to Inactive Vehicles." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente %@ y sus %lld registros, fotos y documentos de todos tus dispositivos. Marcarlo como inactivo conserva todo y lo mueve a Vehículos inactivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci supprime définitivement %@ ainsi que ses %lld enregistrements, photos et documents de tous vos appareils. Le marquer comme inactif conserve tout et le déplace dans Véhicules inactifs."
          }
        }
      }
    },
