        }
      }
    },
    "Row numbers match the file as opened in a spreadsheet app, so you can find and fix these in the original file." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los números de fila coinciden con el archivo abierto en una app de hojas de cálculo, así que puedes encontrarlas y corregirlas en el archivo original."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les numéros de ligne correspondent au fichier ouvert dans un tableur, ce qui vous permet de les retrouver et de les corriger dans le fichier d'origine."
          }
        }
      }
    },
    "Rows that couldn't be read and won't be imported: %lld — see below." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
