          }
        }
      }
    },
    "TRUE COST OF OWNERSHIP" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "COSTO REAL DE PROPIEDAD"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "COÛT RÉEL DE POSSESSION"
          }
        }
      }
    },
    "Turn on \"Repeat Every X Months\" above to enable notifications — odometer-only reminders can't be scheduled in advance, since there's no way to predict when a certain odometer reading will be reached." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa «Repetir cada X meses» arriba para habilitar las notificaciones: los recordatorios solo por odómetro no se pueden programar con antelación, porque no hay forma de predecir cuándo se alcanzará cierta lectura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez « Répéter tous les X mois » ci-dessus pour activer les notifications : les rappels basés uniquement sur le compteur ne peuvent pas être programmés à l'avance, car il est impossible de prévoir quand un kilométrage donné sera atteint."
          }
        }
      }
    },
    "Turn on repeat by %@, by date, or both." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa repetir por %@, por fecha o ambos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez la répétition par %@, par date, ou les deux."
          }
        }
      }
    },
    "Turn this off when you sell or retire this vehicle. It moves to the Inactive Vehicles list, but all of its history stays intact and can still be viewed." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactiva esto cuando vendas o retires este vehículo. Pasa a la lista de vehículos inactivos, pero todo su historial se conserva y se puede seguir consultando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez ceci lorsque vous vendez ou retirez ce véhicule. Il passe dans la liste des véhicules inactifs, mais tout son historique est conservé et reste consultable."
          }
        }
      }
    },
