            "value" : "Roadworthy"
          }
        }
      }
    },
    "Roadworthy Can't Open Your Data" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadworthy no puede abrir tus datos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadworthy ne peut pas ouvrir vos données"
          }
        }
      }
    },
    "Roadworthy couldn't connect to its iCloud storage, so changes on this device aren't syncing. Don't delete the app until this is resolved. Anything added since then exists only on this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadworthy no pudo conectarse a su almacenamiento de iCloud, por lo que los cambios en este dispositivo no se sincronizan. No elimines la app hasta resolverlo. Lo agregado desde entonces existe solo en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadworthy n'a pas pu se connecter à son stockage iCloud ; les modifications faites sur cet appareil ne sont donc pas synchronisées. Ne supprimez pas l'app tant que le problème n'est pas résolu. Tout ce qui a été ajouté depuis n'existe que sur cet appareil."
          }
        }
      }
    },
    "Roadworthy doesn't have permission to send notifications. Turn them on in Settings, then come back and enable \"Notify Me\" again." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadworthy no tiene permiso para enviar notificaciones. Actívalas en Ajustes y luego vuelve a activar «Notificarme»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadworthy n'a pas l'autorisation d'envoyer des notifications. Activez-les dans les Réglages, puis revenez activer « Me notifier »."
          }
        }
      }
    },
