    "Trips shorter than 1 mile can't be saved, because distances are stored in whole miles." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pueden guardar viajes de menos de 1 milla, porque las distancias se guardan en millas enteras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les trajets de moins d'1 mile ne peuvent pas être enregistrés, car les distances sont stockées en miles entiers."
          }
        }
      }
    },
    "Truck" : {
      "extractionState" : "manual",
