      }
    },
    "Fastest way: scan the barcode on the driver's door jamb sticker." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La forma más rápida: escanee el código de barras de la etiqueta del marco de la puerta del conductor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plus rapide : scannez le code-barres de l'étiquette de l'encadrement de la porte conducteur."
          }
        }
      }
    },
    "Fill-up on %@. Add the reading so it can count toward MPG." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carga del %@. Agrega la lectura para que cuente en el MPG."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plein du %@. Ajoutez le relevé pour qu'il compte dans le MPG."
          }
        }
      }
    },
    "Turn this on when you filled the tank all the way up. The app calculates MPG from one full tank to the next, so partial fill-ups are counted in between." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actívalo cuando llenaste el tanque por completo. La app calcula el consumo (MPG) de un tanque lleno al siguiente, así que los llenados parciales se cuentan en el medio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez cette option quand vous avez rempli le réservoir complètement. L’app calcule la consommation (MPG) d’un plein au suivant, donc les pleins partiels sont comptés entre les deux."
          }
        }
      }
    },
